  connect \inst_rs1 \inst [19:15]
  connect \inst_rs2 \inst [24:20]
  connect \next_pc \mux_next_pc_select.multiplexer.out
  connect \pc \program_counter.value
  connect \pc_plus_4 \adder_pc_plus_4.result
  connect \pc_plus_immediate \adder_pc_plus_immediate.result
  connect \rd_data \mux_reg_writeback.multiplexer.out
  connect \rs1_data \regfile.rs1_data
  connect \rs2_data \regfile.rs2_data
end
