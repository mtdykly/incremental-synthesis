read_json "/workspace/incremental-synthesis/results/partition-incremental/eco-006/incremental/top-shell/top_shell.json"

hierarchy -top riscv_core

# Map sequential cells to the target standard-cell library.
dfflibmap -liberty "/workspace/incremental-synthesis/partition-incremental/area-analysis/lib/NangateOpenCellLibrary_typical.lib"

# Map combinational logic to the same library.
abc -liberty "/workspace/incremental-synthesis/partition-incremental/area-analysis/lib/NangateOpenCellLibrary_typical.lib"

opt_clean -purge

write_json "/workspace/incremental-synthesis/results/partition-incremental/eco-006/area-analysis/liberty-area/incremental-mapped/top-shell/mapped.json"

write_verilog -noattr -noexpr -nodec     "/workspace/incremental-synthesis/results/partition-incremental/eco-006/area-analysis/liberty-area/incremental-mapped/top-shell/mapped_netlist.v"
