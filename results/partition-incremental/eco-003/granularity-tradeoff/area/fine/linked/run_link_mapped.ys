read_json "/workspace/incremental-synthesis/results/partition-incremental/eco-003/granularity-tradeoff/area/fine/partitions/immediate_generator/mapped.json"
# instruction_decoder -> instruction_decoder
read_json "/workspace/incremental-synthesis/results/partition-incremental/eco-003/granularity-tradeoff/area/fine/partitions/instruction_decoder/mapped.json"
# singlecycle_ctlpath -> singlecycle_ctlpath
read_json "/workspace/incremental-synthesis/results/partition-incremental/eco-003/granularity-tradeoff/area/fine/partitions/singlecycle_ctlpath/mapped.json"
# singlecycle_datapath -> singlecycle_datapath
read_json "/workspace/incremental-synthesis/results/partition-incremental/eco-003/granularity-tradeoff/area/fine/partitions/singlecycle_datapath/mapped.json"

hierarchy -top riscv_core

# Flatten hierarchy only for final measurement.
