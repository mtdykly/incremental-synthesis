[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 1800

[engines]
smtbmc bitwuzla

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/singlecycle_datapath.regfile.register.2.3.sv
read_rtlil ../../../../../partitions/singlecycle_datapath.regfile.register.2.3.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.singlecycle_datapath.regfile.register.2.3
setundef -anyseq gate.singlecycle_datapath.regfile.register.2.3
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

