verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../partitions/singlecycle_datapath.regfile.register.13.6.sv
read_rtlil ../../../partitions/singlecycle_datapath.regfile.register.13.6.il
hierarchy -top miter; proc; chformal -cover -remove
async2sync
formalff -clk2ff -ff2anyinit gate.singlecycle_datapath.regfile.register.13.6
setundef -anyseq gate.singlecycle_datapath.regfile.register.13.6
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
sat -tempinduct -set-init-undef -set-def-formal -set-def-inputs -maxsteps 2 -set-assumes -prove-asserts -show-public -dump_vcd trace.vcd miter
