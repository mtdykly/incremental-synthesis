[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 1800

[engines]
abc pdr

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/immediate_generator.immediate.4.sv
read_rtlil ../../../../../partitions/immediate_generator.immediate.4.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.immediate_generator.immediate.4
setundef -anyseq gate.immediate_generator.immediate.4
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

