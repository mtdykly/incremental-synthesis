[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 1800

[engines]
smtbmc bitwuzla

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/immediate_generator.immediate.16.sv
read_rtlil ../../../../../partitions/immediate_generator.immediate.16.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.immediate_generator.immediate.16
setundef -anyseq gate.immediate_generator.immediate.16
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

