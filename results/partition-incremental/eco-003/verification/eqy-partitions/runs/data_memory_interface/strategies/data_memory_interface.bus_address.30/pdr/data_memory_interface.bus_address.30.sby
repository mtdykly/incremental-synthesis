[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 1800

[engines]
abc pdr

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/data_memory_interface.bus_address.30.sv
read_rtlil ../../../../../partitions/data_memory_interface.bus_address.30.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.data_memory_interface.bus_address.30
setundef -anyseq gate.data_memory_interface.bus_address.30
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

