# Load elaborated hierarchical design.
read_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_cv32e40p-eco-001/base/frontend_hier.json"

# Replace partition implementations with blackboxes.
blackbox cv32e40p_controller$cv32e40p_core.id_stage_i.controller_i
blackbox cv32e40p_decoder$cv32e40p_core.id_stage_i.decoder_i
blackbox cv32e40p_hwloop_regs$cv32e40p_core.id_stage_i.gen_hwloop_regs.hwloop_regs_i
blackbox cv32e40p_int_controller$cv32e40p_core.id_stage_i.int_controller_i
blackbox cv32e40p_register_file$cv32e40p_core.id_stage_i.register_file_i

hierarchy -check -top cv32e40p_id_stage$cv32e40p_core.id_stage_i
check

# Synthesize only the top shell.
synth -top cv32e40p_id_stage$cv32e40p_core.id_stage_i
opt_clean -purge
check
stat -top cv32e40p_id_stage$cv32e40p_core.id_stage_i

select -clear
select cv32e40p_id_stage$cv32e40p_core.id_stage_i
write_json -selected "/workspace/incremental-synthesis/results/partition-incremental/__granularity_cv32e40p-eco-001/base/fine-cache/id_stage_i/root-shell/top_shell.json"
select -clear

write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_cv32e40p-eco-001/base/fine-cache/id_stage_i/root-shell/top_shell.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/__granularity_cv32e40p-eco-001/base/fine-cache/id_stage_i/root-shell/top_shell_netlist.v"
