# Load already elaborated hierarchical design.
read_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/frontend_hier.json"

# Select derived module implementation.
hierarchy -check -top alu_control

proc
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/fine-cache/singlecycle_ctlpath/regions/alu_control/frontend.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/fine-cache/singlecycle_ctlpath/regions/alu_control/frontend.rtlil"

stat -top alu_control

# Flatten logic below the fine-region root.
script /workspace/incremental-synthesis/partition-incremental/yosys/synth_partition.ys

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/fine-cache/singlecycle_ctlpath/regions/alu_control/flattened.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/fine-cache/singlecycle_ctlpath/regions/alu_control/flattened.rtlil"

# Complete generic synthesis.
synth -top alu_control
opt_clean -purge
check
stat -top alu_control

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/fine-cache/singlecycle_ctlpath/regions/alu_control/synth.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/fine-cache/singlecycle_ctlpath/regions/alu_control/synth.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-004/base/fine-cache/singlecycle_ctlpath/regions/alu_control/partition_netlist.v"
