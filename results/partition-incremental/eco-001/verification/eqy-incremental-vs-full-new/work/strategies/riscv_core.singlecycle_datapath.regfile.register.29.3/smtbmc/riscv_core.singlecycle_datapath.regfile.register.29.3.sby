[options]
mode prove
depth 8
expect pass,fail,unknown,timeout

timeout 180

[engines]
smtbmc bitwuzla

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/riscv_core.singlecycle_datapath.regfile.register.29.3.sv
read_rtlil ../../../../../partitions/riscv_core.singlecycle_datapath.regfile.register.29.3.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.riscv_core.singlecycle_datapath.regfile.register.29.3
setundef -anyseq gate.riscv_core.singlecycle_datapath.regfile.register.29.3
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

