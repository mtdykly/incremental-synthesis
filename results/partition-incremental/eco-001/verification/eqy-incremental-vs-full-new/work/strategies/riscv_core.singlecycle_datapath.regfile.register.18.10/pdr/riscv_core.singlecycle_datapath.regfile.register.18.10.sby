[options]
mode prove
depth 5
expect pass,fail,unknown,timeout

timeout 120

[engines]
abc pdr

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/riscv_core.singlecycle_datapath.regfile.register.18.10.sv
read_rtlil ../../../../../partitions/riscv_core.singlecycle_datapath.regfile.register.18.10.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.riscv_core.singlecycle_datapath.regfile.register.18.10
setundef -anyseq gate.riscv_core.singlecycle_datapath.regfile.register.18.10
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

