[options]
mode prove
depth 8
expect pass,fail,unknown,timeout

timeout 180

[engines]
smtbmc bitwuzla

[script]
verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../../../partitions/riscv_core.singlecycle_datapath.regfile.register.4.16.sv
read_rtlil ../../../../../partitions/riscv_core.singlecycle_datapath.regfile.register.4.16.il
hierarchy -top miter; proc

async2sync
formalff -clk2ff -ff2anyinit gate.riscv_core.singlecycle_datapath.regfile.register.4.16
setundef -anyseq gate.riscv_core.singlecycle_datapath.regfile.register.4.16
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
xprop -formal -split-ports -assume-def-inputs miter

