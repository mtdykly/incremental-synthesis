# Load synthesized top shell in native RTLIL format.
read_rtlil "/workspace/incremental-synthesis/results/partition-incremental/eco-001/incremental-profiled/top-shell/top_shell.rtlil"

# Load each independently synthesized partition.
# Existing blackbox partition definitions in the top shell
# are replaced by the real RTLIL implementations.
# data_memory_interface -> data_memory_interface
read_rtlil "/workspace/incremental-synthesis/results/partition-incremental/eco-001/incremental-profiled/partitions/data_memory_interface/synth.rtlil"
# singlecycle_ctlpath -> singlecycle_ctlpath
read_rtlil "/workspace/incremental-synthesis/results/partition-incremental/eco-001/incremental-profiled/partitions/singlecycle_ctlpath/synth.rtlil"
# singlecycle_datapath -> singlecycle_datapath
read_rtlil "/workspace/incremental-synthesis/results/partition-incremental/eco-001/incremental-profiled/partitions/singlecycle_datapath/synth.rtlil"

# Validate the reconstructed hierarchy.
hierarchy -check -top riscv_core
check
stat -top riscv_core

# Export linked design.
write_json "/workspace/incremental-synthesis/results/partition-incremental/eco-001/incremental-profiled/linked/linked.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/eco-001/incremental-profiled/linked/linked.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/eco-001/incremental-profiled/linked/linked_netlist.v"
