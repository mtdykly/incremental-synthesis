read_json "/workspace/incremental-synthesis/results/partition-incremental/eco-005/incremental/partitions/immediate_generator/synth.json"

hierarchy -top immediate_generator

# Map sequential cells to the target standard-cell library.
dfflibmap -liberty "/workspace/incremental-synthesis/partition-incremental/area-analysis/lib/NangateOpenCellLibrary_typical.lib"

# Map combinational logic to the same library.
abc -liberty "/workspace/incremental-synthesis/partition-incremental/area-analysis/lib/NangateOpenCellLibrary_typical.lib"

opt_clean -purge

write_json "/workspace/incremental-synthesis/results/partition-incremental/eco-005/area-analysis/liberty-area/incremental-mapped/partitions/immediate_generator/mapped.json"

write_verilog -noattr -noexpr -nodec     "/workspace/incremental-synthesis/results/partition-incremental/eco-005/area-analysis/liberty-area/incremental-mapped/partitions/immediate_generator/mapped_netlist.v"
