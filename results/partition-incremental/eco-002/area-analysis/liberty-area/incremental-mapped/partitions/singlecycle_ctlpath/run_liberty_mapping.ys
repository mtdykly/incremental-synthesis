read_json "/workspace/incremental-synthesis/results/partition-incremental/eco-002/incremental/partitions/singlecycle_ctlpath/synth.json"

hierarchy -top singlecycle_ctlpath

# Map sequential cells to the target standard-cell library.
dfflibmap -liberty "/workspace/incremental-synthesis/partition-incremental/area-analysis/lib/NangateOpenCellLibrary_typical.lib"

# Map combinational logic to the same library.
abc -liberty "/workspace/incremental-synthesis/partition-incremental/area-analysis/lib/NangateOpenCellLibrary_typical.lib"

opt_clean -purge

write_json "/workspace/incremental-synthesis/results/partition-incremental/eco-002/area-analysis/liberty-area/incremental-mapped/partitions/singlecycle_ctlpath/mapped.json"

write_verilog -noattr -noexpr -nodec     "/workspace/incremental-synthesis/results/partition-incremental/eco-002/area-analysis/liberty-area/incremental-mapped/partitions/singlecycle_ctlpath/mapped_netlist.v"
