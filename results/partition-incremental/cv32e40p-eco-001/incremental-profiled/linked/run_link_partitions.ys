# Load synthesized top shell in native RTLIL format.
read_rtlil "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/incremental-profiled/top-shell/top_shell.rtlil"

# Load each independently synthesized partition.
