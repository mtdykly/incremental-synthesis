# Load full frontend hierarchy.
read_json "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/new/frontend_hier.json"

# Replace first-level partition implementations with blackboxes.
# cs_registers_i -> cv32e40p_cs_registers$cv32e40p_core.cs_registers_i
blackbox cv32e40p_cs_registers$cv32e40p_core.cs_registers_i
# ex_stage_i -> cv32e40p_ex_stage$cv32e40p_core.ex_stage_i
blackbox cv32e40p_ex_stage$cv32e40p_core.ex_stage_i
# id_stage_i -> cv32e40p_id_stage$cv32e40p_core.id_stage_i
blackbox cv32e40p_id_stage$cv32e40p_core.id_stage_i
# if_stage_i -> cv32e40p_if_stage$cv32e40p_core.if_stage_i
blackbox cv32e40p_if_stage$cv32e40p_core.if_stage_i
# load_store_unit_i -> cv32e40p_load_store_unit$cv32e40p_core.load_store_unit_i
blackbox cv32e40p_load_store_unit$cv32e40p_core.load_store_unit_i
# sleep_unit_i -> cv32e40p_sleep_unit$cv32e40p_core.sleep_unit_i
blackbox cv32e40p_sleep_unit$cv32e40p_core.sleep_unit_i

hierarchy -check -top cv32e40p_core
check

# Export ONLY the unsynthesized top module.
select -clear
select cv32e40p_core
write_json -selected "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/liberty-area/presynth-linked-mapped/presynth_top_shell.json"
select -clear
