# Read the complete RTL design.
read_verilog -sv -I/workspace/incremental-synthesis/benchmarks/cv32e40p-eco-001-new/core -I/workspace/incremental-synthesis/benchmarks/cv32e40p-eco-001-new/core/common "/workspace/incremental-synthesis/benchmarks/cv32e40p-eco-001-new/core/common/normalized_cv32e40p.v"

hierarchy -check -top cv32e40p_core

# Frontend processing.
proc
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/cell-count/full-reference/frontend.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/cell-count/full-reference/frontend.rtlil"

# Full-design flattening.
flatten -noscopeinfo
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/cell-count/full-reference/flattened.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/cell-count/full-reference/flattened.rtlil"

# Full synthesis of the complete design.
synth -top cv32e40p_core
opt_clean -purge
check
stat -top cv32e40p_core

write_json "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/cell-count/full-reference/full_reference.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/cell-count/full-reference/full_reference.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/cv32e40p-eco-001/area-analysis/cell-count/full-reference/full_reference_netlist.v"
