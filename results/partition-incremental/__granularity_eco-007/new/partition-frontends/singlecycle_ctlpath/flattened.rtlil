    parameter \MEMID "$flatten\\alu_control.$auto$proc_rom.cc:155:do_switch$112"
    parameter \INIT_VALUE 5'x
    parameter \COLLISION_X_MASK 0'x
    parameter \CLK_POLARITY 1
    parameter \CLK_ENABLE 0
    parameter \CE_OVER_SRST 0
    parameter \ARST_VALUE 5'x
    parameter \ABITS 3
    connect \SRST 1'0
    connect \EN 1'1
    connect \DATA \alu_control.m_extension_funct
    connect \CLK 1'x
    connect \ARST 1'0
    connect \ADDR \inst_funct3
  end
  connect \alu_control.inst_funct7 \inst_funct7
  connect \alu_control.inst_funct3 \inst_funct3
  connect \control_transfer.result_equal_zero \alu_result_equal_zero
  connect \control_transfer.inst_funct3 \inst_funct3
  connect \singlecycle_control.take_branch \control_transfer.take_branch
  connect \singlecycle_control.inst_opcode \inst_opcode
  connect \singlecycle_control.alu_op_type \alu_control.alu_op_type
  connect \alu_function \alu_control.alu_function
  connect \alu_op_type \alu_control.alu_op_type
  connect \alu_operand_a_select \singlecycle_control.alu_operand_a_select
  connect \alu_operand_b_select \singlecycle_control.alu_operand_b_select
  connect \data_mem_read_enable \singlecycle_control.data_mem_read_enable
  connect \data_mem_write_enable \singlecycle_control.data_mem_write_enable
  connect \next_pc_select \singlecycle_control.next_pc_select
  connect \pc_write_enable \singlecycle_control.pc_write_enable
  connect \reg_writeback_select \singlecycle_control.reg_writeback_select
  connect \regfile_write_enable \singlecycle_control.regfile_write_enable
  connect \take_branch \control_transfer.take_branch
end
