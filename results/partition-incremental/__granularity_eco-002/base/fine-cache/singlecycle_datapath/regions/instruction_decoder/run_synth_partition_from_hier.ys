# Load already elaborated hierarchical design.
read_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/frontend_hier.json"

# Select derived module implementation.
hierarchy -check -top instruction_decoder

proc
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/instruction_decoder/frontend.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/instruction_decoder/frontend.rtlil"

stat -top instruction_decoder

# Flatten logic below the fine-region root.
script /workspace/incremental-synthesis/partition-incremental/yosys/synth_partition.ys

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/instruction_decoder/flattened.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/instruction_decoder/flattened.rtlil"

# Complete generic synthesis.
synth -top instruction_decoder
opt_clean -purge
check
stat -top instruction_decoder

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/instruction_decoder/synth.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/instruction_decoder/synth.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/instruction_decoder/partition_netlist.v"
