# Load already elaborated hierarchical design.
read_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/frontend_hier.json"

# Select derived module implementation.
hierarchy -check -top immediate_generator

proc
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/immediate_generator/frontend.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/immediate_generator/frontend.rtlil"

stat -top immediate_generator

# Flatten logic below the fine-region root.
script /workspace/incremental-synthesis/partition-incremental/yosys/synth_partition.ys

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/immediate_generator/flattened.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/immediate_generator/flattened.rtlil"

# Complete generic synthesis.
synth -top immediate_generator
opt_clean -purge
check
stat -top immediate_generator

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/immediate_generator/synth.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/immediate_generator/synth.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-002/base/fine-cache/singlecycle_datapath/regions/immediate_generator/partition_netlist.v"
