# Load already elaborated hierarchical design.
read_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/new/frontend_hier.json"

# Select derived module implementation.
hierarchy -check -top control_transfer

proc
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/incremental-fine-profiled/partitions/singlecycle_ctlpath/regions/control_transfer/frontend.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/incremental-fine-profiled/partitions/singlecycle_ctlpath/regions/control_transfer/frontend.rtlil"

stat -top control_transfer

# Flatten logic below the fine-region root.
script /workspace/incremental-synthesis/partition-incremental/yosys/synth_partition.ys

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/incremental-fine-profiled/partitions/singlecycle_ctlpath/regions/control_transfer/flattened.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/incremental-fine-profiled/partitions/singlecycle_ctlpath/regions/control_transfer/flattened.rtlil"

# Complete generic synthesis.
synth -top control_transfer
opt_clean -purge
check
stat -top control_transfer

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/incremental-fine-profiled/partitions/singlecycle_ctlpath/regions/control_transfer/synth.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/incremental-fine-profiled/partitions/singlecycle_ctlpath/regions/control_transfer/synth.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/incremental-fine-profiled/partitions/singlecycle_ctlpath/regions/control_transfer/partition_netlist.v"
