# Load already elaborated hierarchical design.
read_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/frontend_hier.json"

# Select derived module implementation.
hierarchy -check -top singlecycle_control

proc
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/fine-cache/singlecycle_ctlpath/regions/singlecycle_control/frontend.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/fine-cache/singlecycle_ctlpath/regions/singlecycle_control/frontend.rtlil"

stat -top singlecycle_control

# Flatten logic below the fine-region root.
script /workspace/incremental-synthesis/partition-incremental/yosys/synth_partition.ys

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/fine-cache/singlecycle_ctlpath/regions/singlecycle_control/flattened.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/fine-cache/singlecycle_ctlpath/regions/singlecycle_control/flattened.rtlil"

# Complete generic synthesis.
synth -top singlecycle_control
opt_clean -purge
check
stat -top singlecycle_control

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/fine-cache/singlecycle_ctlpath/regions/singlecycle_control/synth.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/fine-cache/singlecycle_ctlpath/regions/singlecycle_control/synth.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-001/base/fine-cache/singlecycle_ctlpath/regions/singlecycle_control/partition_netlist.v"
