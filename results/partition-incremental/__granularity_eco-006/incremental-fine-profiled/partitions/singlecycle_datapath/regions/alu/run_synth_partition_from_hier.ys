# Load already elaborated hierarchical design.
read_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/frontend_hier.json"

# Select derived module implementation.
hierarchy -check -top alu

proc
opt_clean
check

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/fine-cache/singlecycle_datapath/regions/alu/frontend.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/fine-cache/singlecycle_datapath/regions/alu/frontend.rtlil"

stat -top alu

# Flatten logic below the fine-region root.
script /workspace/incremental-synthesis/partition-incremental/yosys/synth_partition.ys

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/fine-cache/singlecycle_datapath/regions/alu/flattened.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/fine-cache/singlecycle_datapath/regions/alu/flattened.rtlil"

# Complete generic synthesis.
synth -top alu
opt_clean -purge
check
stat -top alu

write_json "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/fine-cache/singlecycle_datapath/regions/alu/synth.json"
write_rtlil "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/fine-cache/singlecycle_datapath/regions/alu/synth.rtlil"
write_verilog -noattr -noexpr -nodec "/workspace/incremental-synthesis/results/partition-incremental/__granularity_eco-006/base/fine-cache/singlecycle_datapath/regions/alu/partition_netlist.v"
