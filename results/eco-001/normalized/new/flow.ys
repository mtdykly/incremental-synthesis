read_verilog -sv -I/__DESIGN_ROOT__/core/common -I/__DESIGN_ROOT__/core/singlecycle -I/__DESIGN_ROOT__/synth /__DESIGN_ROOT__/core/common/adder.sv /__DESIGN_ROOT__/core/common/alu.sv /__DESIGN_ROOT__/core/common/alu_control.sv /__DESIGN_ROOT__/core/common/constants.sv /__DESIGN_ROOT__/core/common/control_transfer.sv /__DESIGN_ROOT__/core/common/data_memory_interface.sv /__DESIGN_ROOT__/core/common/example_data_memory_bus.sv /__DESIGN_ROOT__/core/common/example_memory_bus.sv /__DESIGN_ROOT__/core/common/example_text_memory_bus.sv /__DESIGN_ROOT__/core/common/immediate_generator.sv /__DESIGN_ROOT__/core/common/instruction_decoder.sv /__DESIGN_ROOT__/core/common/multiplexer.sv /__DESIGN_ROOT__/core/common/multiplexer2.sv /__DESIGN_ROOT__/core/common/multiplexer4.sv /__DESIGN_ROOT__/core/common/multiplexer8.sv /__DESIGN_ROOT__/core/common/regfile.sv /__DESIGN_ROOT__/core/common/register.sv /__DESIGN_ROOT__/core/singlecycle/riscv_core.sv /__DESIGN_ROOT__/core/singlecycle/singlecycle_control.sv /__DESIGN_ROOT__/core/singlecycle/singlecycle_ctlpath.sv /__DESIGN_ROOT__/core/singlecycle/singlecycle_datapath.sv

# ============================================================
# 第一阶段：RTL 前端处理
# ============================================================

# 确定顶层模块，并删除顶层不可达模块
hierarchy -check -top riscv_core

# 将 always、case、if 等过程结构转换为内部 cell 和连接
proc

# 删除简单的无效逻辑和未使用对象
opt_clean

# 检查当前设计
check

# 将前端处理后的设计写出
write_json /__RESULT_ROOT__/frontend.json
write_rtlil /__RESULT_ROOT__/frontend.rtlil

# 将当前统计信息写入 yosys.log
stat -top riscv_core

# ============================================================
# 第二阶段：完整逻辑综合
# ============================================================

synth -top riscv_core

# 清理综合后无用的 cell 和 wire
opt_clean -purge

# 检查综合结果
check

# 输出综合统计信息
stat -top riscv_core

# 将综合后的设计写出
write_json /__RESULT_ROOT__/synth.json
write_rtlil /__RESULT_ROOT__/synth.rtlil

# 输出结构化 Verilog 网表
write_verilog -noattr -noexpr -nodec     /__RESULT_ROOT__/riscv_core_netlist.v
