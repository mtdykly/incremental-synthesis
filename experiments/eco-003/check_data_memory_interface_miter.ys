# ============================================================
# base netlist
# ============================================================

read_json results/eco-003/base-normalized/synth.json
hierarchy -check -top data_memory_interface
rename data_memory_interface gold
design -stash gold

design -reset

# ============================================================
# new netlist
# ============================================================

read_json results/eco-003/new-normalized/synth.json
hierarchy -check -top data_memory_interface
rename data_memory_interface gate
design -stash gate

design -reset

# ============================================================
# Construct output miter
# ============================================================

design -copy-from gold -as gold gold
design -copy-from gate -as gate gate

miter -equiv -flatten -make_outputs -make_outcmp \
    gold gate miter

hierarchy -check -top miter
opt_clean

sat -verify \
    -prove trigger 0 \
    -show-inputs \
    -show-outputs \
    miter
